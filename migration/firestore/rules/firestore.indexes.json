{
  "//": [
    "Composite indexes derived from the queries the application actually runs,",
    "not from the source index list. Every entry below traces to a real access",
    "path: the trips page, the deleted-trips page, analytics, and the",
    "installment/receivable views. Firestore indexes single fields",
    "automatically, so nothing single-field appears here.",
    "",
    "Every index leads with ownerUid. That is not decoration: rules are",
    "evaluated per document, so a query without the ownerUid constraint fails",
    "outright, and an index that did not lead with it could never be used by a",
    "query that will actually be permitted.",
    "",
    "createdAt is the tie-breaker on paginated shapes, and __name__ follows",
    "implicitly, so cursors stay stable when two documents share a sort value."
  ],
  "indexes": [
    {
      "//": "Trips page: owner's active trips, newest first (trips_active_page_idx).",
      "collectionGroup": "trips",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Trips filtered by status, newest first (trips_active_status_idx).",
      "collectionGroup": "trips",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Receivables: trips by payment status (trips_payment_status_idx).",
      "collectionGroup": "trips",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "paymentStatus", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Analytics and date-range reporting by departure (trips_analytics_start_idx).",
      "collectionGroup": "trips",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "startDate", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Analytics by payment date (trips_analytics_payment_date_idx).",
      "collectionGroup": "trips",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "paymentDate", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Currency breakdown in analytics.",
      "collectionGroup": "trips",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "currency", "order": "ASCENDING" },
        { "fieldPath": "startDate", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Deleted-trips page, most recently deleted first (trips_deleted_idx).",
      "collectionGroup": "trips",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "deletedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Trips belonging to one business, for tenant-scoped reporting.",
      "collectionGroup": "trips",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "businessId", "order": "ASCENDING" },
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Installments due in a date range, by status (trip_installments_due_idx).",
      "collectionGroup": "tripInstallments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "dueDate", "order": "ASCENDING" }
      ]
    },
    {
      "//": "A trip's own schedule, in installment order.",
      "collectionGroup": "tripInstallments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "tripId", "order": "ASCENDING" },
        { "fieldPath": "installmentNumber", "order": "ASCENDING" }
      ]
    },
    {
      "//": "The active plan for a trip (trip_payment_plans_user_idx).",
      "collectionGroup": "tripPaymentPlans",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "tripId", "order": "ASCENDING" },
        { "fieldPath": "updatedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Payment events for one plan, newest first (trip_payment_events_idx).",
      "collectionGroup": "tripPaymentEvents",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "paymentPlanId", "order": "ASCENDING" },
        { "fieldPath": "sequence", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Installment events in source order (trip_installment_events_idx).",
      "collectionGroup": "tripInstallmentEvents",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "installmentId", "order": "ASCENDING" },
        { "fieldPath": "sequence", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Financial audit for one trip, in source order.",
      "collectionGroup": "tripFinancialAudit",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "tripId", "order": "ASCENDING" },
        { "fieldPath": "sequence", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Activity log for one trip, in source order.",
      "collectionGroup": "tripActivityLog",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "tripId", "order": "ASCENDING" },
        { "fieldPath": "sequence", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Audit events for one business, newest first.",
      "collectionGroup": "auditEvents",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "businessId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}

{
  "//": [
    "Phase 2 index inventory contains only query shapes executed by the travel repository.",
    "Single-field and equality-only lookups use Firestore's automatic indexes/index merging.",
    "Every tenant query includes ownerUid and businessId; rules still enforce ownership per document."
  ],
  "indexes": [
    {
      "//": "FirestoreTravelRepository.listTripsForBusiness: tenant, deletion state, start-date cursor.",
      "collectionGroup": "trips",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "businessId", "order": "ASCENDING" },
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "startDate", "order": "ASCENDING" },
        { "fieldPath": "__name__", "order": "ASCENDING" }
      ]
    },
    {
      "//": "FirestoreTravelRepository.listTripsForBusiness with a status filter.",
      "collectionGroup": "trips",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "businessId", "order": "ASCENDING" },
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "startDate", "order": "ASCENDING" },
        { "fieldPath": "__name__", "order": "ASCENDING" }
      ]
    },
    {
      "//": "FirestoreTravelRepository.listDueInstallments: tenant, active status set, due date.",
      "collectionGroup": "tripInstallments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "businessId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "dueDate", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": [
    { "collectionGroup": "trips", "fieldPath": "travelers", "indexes": [] },
    { "collectionGroup": "trips", "fieldPath": "itinerary", "indexes": [] },
    { "collectionGroup": "trips", "fieldPath": "payments", "indexes": [] },
    { "collectionGroup": "trips", "fieldPath": "attachments", "indexes": [] },
    { "collectionGroup": "trips", "fieldPath": "notes", "indexes": [] },
    { "collectionGroup": "trips", "fieldPath": "searchDocument", "indexes": [] },
    { "collectionGroup": "tripFinancialAudit", "fieldPath": "previousValue", "indexes": [] },
    { "collectionGroup": "tripFinancialAudit", "fieldPath": "newValue", "indexes": [] },
    { "collectionGroup": "tripActivityLog", "fieldPath": "metadata", "indexes": [] },
    { "collectionGroup": "auditEvents", "fieldPath": "details", "indexes": [] },
    { "collectionGroup": "idempotency", "fieldPath": "responsePayload", "indexes": [] },
    { "collectionGroup": "storageCleanupQueue", "fieldPath": "attachments", "indexes": [] },
    { "collectionGroup": "storageCleanupQueue", "fieldPath": "lastError", "indexes": [] }
  ]
}

    function sv_restaurant_menu_items(d) {
      return d.keys().hasOnly(['allergens', 'availableDays', 'availableFrom', 'availableUntil', 'barcode', 'businessId', 'calories', 'categoryId', 'costPrice', 'countryOfOrigin', 'createdAt', 'createdAtMicros', 'createdBy', 'defaultShelfLifeDays', 'description', 'dietaryTags', 'id', 'imageUrl', 'isAvailable', 'isDeleted', 'isNew', 'isPerishable', 'isPopular', 'legacyBusinessUserId', 'migrationExcludedFields', 'migrationTransformVersion', 'minStockAlert', 'name', 'nameAr', 'nameHe', 'ownerUid', 'partNumber', 'prepTimeMinutes', 'price', 'requiresWeighing', 'schemaVersion', 'soldByWeight', 'sortOrder', 'spicyLevel', 'station', 'stockQuantity', 'supplierSku', 'taxRate', 'trackExpiry', 'transformVersion', 'type', 'weightUnit']) && [

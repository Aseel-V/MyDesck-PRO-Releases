      return changed.hasOnly(['allergies', 'anniversary', 'averageCheck', 'birthdate', 'businessId', 'createdAt', 'createdAtMicros', 'createdBy', 'dietaryRestrictions', 'email', 'favoriteItems', 'firstName', 'fullName', 'id', 'isDeleted', 'lastName', 'lastVisitDate', 'legacyBusinessUserId', 'marketingOptIn', 'migrationExcludedFields', 'migrationTransformVersion', 'noisePreference', 'notes', 'ownerUid', 'phone', 'preferredServerId', 'schemaVersion', 'seatingPreference', 'tags', 'totalLifetimeSpend', 'transformVersion', 'updatedAt', 'updatedAtMicros', 'vipLevel', 'visitCount', 'whatsappOptIn']) && (changed.size() > 11 ? sv_restaurant_guest_profiles(d) : [
        !('id' in changed) || (d.id is string),
        !('legacyBusinessUserId' in changed) || (d.legacyBusinessUserId is string),
        !('firstName' in changed) || (d.firstName is string),
        !('totalLifetimeSpend' in changed) || (d.totalLifetimeSpend == null || sfDecimal(d.totalLifetimeSpend)),
        !('averageCheck' in changed) || (d.averageCheck == null || sfDecimal(d.averageCheck)),
        !('lastVisitDate' in changed) || (d.lastVisitDate == null || d.lastVisitDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')),
        !('favoriteItems' in changed) || (d.favoriteItems == null || d.favoriteItems is list),
        !('dietaryRestrictions' in changed) || (d.dietaryRestrictions == null || d.dietaryRestrictions is list),
        !('allergies' in changed) || (d.allergies == null || d.allergies is list),
        !('seatingPreference' in changed) || (d.seatingPreference in [null, 'booth', 'table', 'patio', 'bar', 'any']),
        !('noisePreference' in changed) || (d.noisePreference in [null, 'quiet', 'lively', 'any']),
        !('tags' in changed) || (d.tags == null || d.tags is list),
        !('birthdate' in changed) || (d.birthdate == null || d.birthdate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')),
        !('anniversary' in changed) || (d.anniversary == null || d.anniversary.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')),
        !('vipLevel' in changed) || (d.vipLevel in [null, 0, 1, 2, 3]),
        !changed.hasAny(['createdAt', 'createdAtMicros']) || ((d.createdAt is timestamp) && (d.get('createdAtMicros', '0').matches('-?[0-9]+'))),
        !changed.hasAny(['updatedAt', 'updatedAtMicros']) || ((d.updatedAt is timestamp) && (d.get('updatedAtMicros', '0').matches('-?[0-9]+'))),
        !changed.hasAny(['lastName', 'fullName', 'phone', 'email', 'preferredServerId', 'notes']) || (sfStrings([d.lastName, d.fullName, d.phone, d.email, d.preferredServerId, d.notes])),
        !changed.hasAny(['marketingOptIn', 'whatsappOptIn']) || (sfBools([d.marketingOptIn, d.whatsappOptIn])),
        !('visitCount' in changed) || (d.visitCount == null || d.visitCount is int),
        !('schemaVersion' in changed) || (d.get('schemaVersion', 1) == 1)
      ].hasOnly([true]));
    }
    // SCHEMA-VALIDATORS:END

    // users/{uid} holds the user_profiles row; the document id is the Firebase uid.
    match /users/{uid} {
      function protectedFields() {
        return ['uid','userId','ownerUid','role','isSuspended','canViewFinancials',
          'businessId','sourceBusinessId','schemaVersion','createdAt','legacyProfileId','id',
          'migrationAuthOnly','createdBy'];
      }
      function incoming() { return request.resource.data; }
      allow get: if (signedIn() && request.auth.uid == uid) || adminReadOnly() || isPlatformAdmin();
      allow list: if adminReadOnly() || isPlatformAdmin();
      allow create: if signedIn()
        && sv_user_profiles(incoming())
        && incoming().uid == uid && incoming().userId == uid
        && incoming().legacyProfileId == incoming().id
        && incoming().isSuspended == false
        && incoming().canViewFinancials == false
        && incoming().createdAt is timestamp
        && incoming().get('migrationAuthOnly', false) == false
        && incoming().isDeleted == false
        && (
          // Self-registration: a plain user, owning nothing or the business created in the same batch.
          (request.auth.uid == uid
            && incoming().role == 'user'
            && incoming().sourceBusinessId == null
            && !('createdBy' in incoming())
            && incoming().ownerUid == uid
            && (incoming().businessId == null
              || getAfter(businessOwnerPath(uid)).data.businessId == incoming().businessId))
          // A platform administrator creating an account: the create-user Edge Function's authority.
          || (request.auth.uid != uid
            && isPlatformAdmin()
            && incoming().role in ['user', 'admin']
            && incoming().createdBy == request.auth.uid
            && incoming().sourceBusinessId == incoming().businessId
            && (incoming().businessId == null
              ? incoming().ownerUid == uid
              : existsAfter(businessPath(incoming().businessId))
                && incoming().ownerUid == getAfter(businessPath(incoming().businessId)).data.ownerUid))
        );
      function validSelfEdit(changed) {
        return !changed.hasAny(protectedFields())
          && changed.hasOnly(['fullName','phoneNumber','updatedAt','updatedAtMicros'])
          && request.resource.data.fullName is string
          && request.resource.data.phoneNumber is string
          && svu_user_profiles(changed, request.resource.data);
      }
      allow update: if signedIn() && request.auth.uid == uid
        && validSelfEdit(request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if false;
    }

    // One business per owner: the replacement for UNIQUE(business_profiles.user_id). A business can
    // only be created in the same batch as a previously absent index document naming it.
    match /businessOwners/{ownerUid} {
      allow get: if signedIn() && (request.auth.uid == ownerUid || isPlatformAdmin());
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'businessId', 'schemaVersion',
          'transformVersion', 'migrationTransformVersion'])
        && request.resource.data.uid == ownerUid
        && request.resource.data.businessId is string
        && request.resource.data.schemaVersion == 1
        && (request.auth.uid == ownerUid || isPlatformAdmin())
        && !exists(businessPath(request.resource.data.businessId))
        && existsAfter(businessPath(request.resource.data.businessId))
        && getAfter(businessPath(request.resource.data.businessId)).data.ownerUid == ownerUid;
      allow update, delete: if false;
    }

    match /businesses/{businessId} {
      allow get: if adminReadOnly() || isPlatformAdmin()
        || (signedIn() && exists(userPath(request.auth.uid))
          && profile().get('isSuspended', false) == false
          && (resource.data.ownerUid == request.auth.uid
            || (profile().get('businessId', null) != null && profile().businessId == businessId)))
        || hasActiveMembership(businessId);
      allow list: if adminReadOnly() || isPlatformAdmin()
        || (signedIn() && exists(userPath(request.auth.uid))
          && profile().get('isSuspended', false) == false
          && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && sv_business_profiles(request.resource.data)
        && request.resource.data.id == businessId
        && request.resource.data.businessId == businessId
        && request.resource.data.ownerUid == request.resource.data.userId
        && request.resource.data.isSuspended == false
        && request.resource.data.subscriptionStatus == 'trial'
        && request.resource.data.trialStartDate == request.time
        && request.resource.data.isDeleted == false
        && notInlineImage(request.resource.data.logoUrl)
        && notInlineImage(request.resource.data.signatureUrl)
        && !exists(businessOwnerPath(request.resource.data.ownerUid))
        && getAfter(businessOwnerPath(request.resource.data.ownerUid)).data.businessId == businessId
        && (request.resource.data.ownerUid == request.auth.uid
          ? !('createdBy' in request.resource.data)
          : isPlatformAdmin() && request.resource.data.createdBy == request.auth.uid);
      // The owner edits what Settings edits. Type, subscription, trial and suspension are not
      // owner-writable here, although the source RLS let an owner update them on their own row.
      // No write may put a resolved image (data: or blob:) where a Storage reference belongs.
      function validOwnerEdit(changed, d) {
        return changed.hasOnly(['businessName','logoUrl','preferredCurrency','preferredLanguage',
            'businessRegistrationNumber','signatureUrl','updatedAt','updatedAtMicros'])
          && svu_business_profiles(changed, d)
          && (!('logoUrl' in changed) || notInlineImage(d.logoUrl))
          && (!('signatureUrl' in changed) || notInlineImage(d.signatureUrl));
      }
      allow update: if isActiveOwner(businessId)
        && validOwnerEdit(request.resource.data.diff(resource.data).affectedKeys(), request.resource.data);
      allow delete: if false;
      match /settings/{settingsId} {
        allow read: if activeTenant(businessId);
        allow create, update: if activeTenant(businessId)
          && request.resource.data.businessId == businessId
          && request.resource.data.ownerUid == get(businessPath(businessId)).data.ownerUid;
        allow delete: if false;
      }

      // ---- Owner-scoped business data ----------------------------------------------------------
      // Every table below is scoped in the source by business_id = auth.uid(): the owner, not a
      // linked user. The path fixes the tenant; the stored tenancy fields must agree with it and
      // can never change afterwards.
      function newOwnerTenancy(d) {
        return d.businessId == businessId
          && d.ownerUid == bizOwnerUid()
          && d.legacyBusinessUserId == bizOwnerUid()
          && d.isDeleted == false;
      }
      // A restaurant menu item belongs to the business through its category and carries no business_id of its own.
      function catalogItemTenancy(d) {
        return d.businessId == businessId && d.ownerUid == bizOwnerUid() && d.isDeleted == false
          && (d.legacyBusinessUserId == bizOwnerUid()
            || (d.legacyBusinessUserId == null && d.categoryId != null && menuCategoryExists(d.categoryId)));
      }
      function tenancyKept(changed) {
        return !changed.hasAny(['id', 'businessId', 'ownerUid', 'legacyBusinessUserId', 'schemaVersion', 'isDeleted', 'createdBy']);
      }
      function menuCategoryExists(id) {
        return exists(/databases/$(database)/documents/businesses/$(businessId)/menuCategories/$(id));
      }

      // Supermarket and restaurant catalogue (restaurant_menu_items / restaurant_menu_categories). Restaurant managers edit
      // the menu, kitchen staff may only mark an item available or unavailable (86).
      match /menuItems/{itemId} {
        function validItemEdit(changed, d) {
          return svu_restaurant_menu_items(changed, d)
            && tenancyKept(changed)
            && (!('categoryId' in changed) || d.categoryId == null || menuCategoryExists(d.categoryId))
            && (!('imageUrl' in changed) || notInlineImage(d.imageUrl));
        }
        allow get, list: if restaurantReader();
        allow create: if restaurantManager()
          && sv_restaurant_menu_items(request.resource.data)
          && request.resource.data.id == itemId
          && catalogItemTenancy(request.resource.data)
          && (request.resource.data.categoryId == null || menuCategoryExists(request.resource.data.categoryId))
          && notInlineImage(request.resource.data.imageUrl);
        allow update: if (restaurantManager()
            && validItemEdit(request.resource.data.diff(resource.data).affectedKeys(), request.resource.data))
          || (memberRoleIn(['kitchen_staff'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAvailable'])
            && svu_restaurant_menu_items(request.resource.data.diff(resource.data).affectedKeys(), request.resource.data));
        allow delete: if restaurantManager();
      }
      match /menuCategories/{categoryId} {
        function validCategoryEdit(changed, d) {
          return svu_restaurant_menu_categories(changed, d)
            && tenancyKept(changed)
            && (!('parentId' in changed) || d.parentId == null || menuCategoryExists(d.parentId));
        }
        allow get, list: if restaurantReader();
        allow create: if restaurantManager()
          && sv_restaurant_menu_categories(request.resource.data)
          && request.resource.data.id == categoryId
          && newOwnerTenancy(request.resource.data)
          && (request.resource.data.parentId == null || menuCategoryExists(request.resource.data.parentId));
        allow update: if restaurantManager()
          && validCategoryEdit(request.resource.data.diff(resource.data).affectedKeys(), request.resource.data);
        allow delete: if restaurantManager();
      }

      // Supermarket sales (market_transactions).
      match /marketTransactions/{transactionId} {
        allow get, list: if isActiveOwner(businessId);
        allow create: if isActiveOwner(businessId)
          && sv_market_transactions(request.resource.data)
          && request.resource.data.id == transactionId
          && newOwnerTenancy(request.resource.data)
          && (request.resource.data.orderId == null
            || exists(/databases/$(database)/documents/businesses/$(businessId)/orders/$(request.resource.data.orderId)));
        // The product edits a sale's items and totals (EditTransactionModal). Receipt number, time,
        // payment method, tender and tenancy stay as recorded.
        function validSaleEdit(changed, d) {
          return changed.hasOnly(['items', 'itemsEncoding', 'itemsJson', 'itemsTextReason', 'totalAmount', 'subtotal', 'vatAmount'])
            && svu_market_transactions(changed, d);
        }
        allow update: if isActiveOwner(businessId)
          && validSaleEdit(request.resource.data.diff(resource.data).affectedKeys(), request.resource.data);
        allow delete: if isActiveOwner(businessId);
      }

      // Dependents of a catalogue item. The source RLS lets the owner do everything on these tables.
      // The supermarket reads them only to reproduce the source foreign keys when a product is
      // deleted (NO ACTION refuses, CASCADE removes); their writes arrive with the vertical that owns
      // a reachable flow for them, and until then stay refused.
      match /shrinkageRecords/{recordId} { allow get, list: if restaurantReader(); }
      match /stockTakeItems/{itemId} { allow get, list: if restaurantReader(); }
      match /inventoryBatches/{batchId} { allow get, list: if restaurantReader(); allow delete: if restaurantManager(); }
      match /itemModifierGroups/{linkId} { allow get, list: if restaurantReader(); allow delete: if restaurantManager(); }
      match /recipes/{recipeId} { allow get, list: if restaurantReader(); allow delete: if restaurantManager(); }

      // ---- Auto repair (customer_vehicles, repair_orders, repair_order_items, car_parts stock) -------------------
      // The source scopes these tables by business_id = the owner's business_profiles.id and admits the owner through
      // business_profiles.user_id = auth.uid(): the owner only. Every multi-document write is checked against the
      // documents before and after it, so no amount or stock level is taken from the client on trust.
      function scopedPath(name, id) { return /databases/$(database)/documents/businesses/$(businessId)/$(name)/$(id); }
      function newBusinessTenancy(d) {
        return d.businessId == businessId && d.ownerUid == request.auth.uid && d.sourceBusinessId == businessId && d.isDeleted == false;
      }
      function decimalOrZero(v) { return v == null ? { 'unitsText': '0', 'scale': 0 } : v; }
      function pow10(n) { return [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000][n]; }
      function aligned(v, scale) { return int(v.unitsText) * pow10(scale - v.scale); }
      // NUMERIC arithmetic as PostgreSQL does it: exact, at the larger scale of the operands.
      function isSum2(result, a, b) {
        return result.scale == (a.scale > b.scale ? a.scale : b.scale)
          && int(result.unitsText) == aligned(a, result.scale) + aligned(b, result.scale);
      }
      function isSum3(result, a, b, c) {
        let scale = a.scale > b.scale ? (a.scale > c.scale ? a.scale : c.scale) : (b.scale > c.scale ? b.scale : c.scale);
        return result.scale == scale && int(result.unitsText) == aligned(a, scale) + aligned(b, scale) + aligned(c, scale);
      }
      function isProduct(result, unit, quantity) {
        return result.scale == unit.scale && int(result.unitsText) == int(unit.unitsText) * quantity;
      }

      // One vehicle per plate: vehiclePlates/{sha256(plate)} is created with the vehicle and never changes.
      match /vehicles/{vehicleId} {
        function plateKeyOf(plate) { return hashing.sha256(plate).toHexString().lower(); }
        function validVehicleEdit(changed, d) {
          return changed.hasOnly(['model', 'ownerName', 'ownerPhone', 'color', 'year', 'testExpiry', 'trimLevel', 'ownership',
              'updatedAt', 'updatedAtMicros'])
            && svu_customer_vehicles(changed, d);
        }
        allow get, list: if isActiveOwner(businessId);
        allow create: if isActiveOwner(businessId)
          && sv_customer_vehicles(request.resource.data)
          && request.resource.data.id == vehicleId
          && newBusinessTenancy(request.resource.data)
          && !exists(scopedPath('vehiclePlates', plateKeyOf(request.resource.data.plateNumber)))
          && getAfter(scopedPath('vehiclePlates', plateKeyOf(request.resource.data.plateNumber))).data.vehicleId == vehicleId;
        allow update: if isActiveOwner(businessId)
          && validVehicleEdit(request.resource.data.diff(resource.data).affectedKeys(), request.resource.data);
        // The source grants no delete on customer_vehicles, and no screen deletes a vehicle.
        allow delete: if false;
      }
      match /vehiclePlates/{plateKey} {
        allow get: if isActiveOwner(businessId);
        allow list: if false;
        allow create: if isActiveOwner(businessId)
          && request.resource.data.keys().hasOnly(['plateNumber', 'vehicleId', 'businessId', 'schemaVersion'])
          && request.resource.data.plateNumber is string
          && request.resource.data.vehicleId is string
          && request.resource.data.businessId == businessId
          && request.resource.data.schemaVersion == 1
          && plateKey == hashing.sha256(request.resource.data.plateNumber).toHexString().lower()
          && !exists(scopedPath('vehicles', request.resource.data.vehicleId))
          && getAfter(scopedPath('vehicles', request.resource.data.vehicleId)).data.plateNumber == request.resource.data.plateNumber;
        allow update, delete: if false;
      }

      match /repairOrders/{orderId} {
        // NewCarForm opens a job as 'working', unpaid and with zero amounts, on a vehicle of this business.
        function openedOrder(d) {
          return d.status == 'working' && d.customerId == null && d.completedAt == null && d.paymentMethod == null
            && d.paymentStatus == 'unpaid' && d.get('lastRepairServiceId', null) == null
            && int(d.partsTotal.unitsText) == 0 && int(d.laborTotal.unitsText) == 0 && int(d.discount.unitsText) == 0
            && int(d.totalAmount.unitsText) == 0 && int(d.paidAmount.unitsText) == 0;
        }
        // The only reachable change to a job is add_repair_service_transaction: totals move only together with a new,
        // immutable service record in the same write, whose rule recomputes every amount.
        function validServiceTotals(orderId, changed, d) {
          return changed.hasOnly(['partsTotal', 'laborTotal', 'totalAmount', 'updatedAt', 'updatedAtMicros', 'lastRepairServiceId'])
            && 'lastRepairServiceId' in changed
            && svu_repair_orders(changed, d)
            && d.updatedAt == request.time
            && !exists(scopedPath('repairServices', d.lastRepairServiceId))
            && getAfter(scopedPath('repairServices', d.lastRepairServiceId)).data.orderId == orderId;
        }
        allow get, list: if isActiveOwner(businessId);
        allow create: if isActiveOwner(businessId)
          && sv_repair_orders(request.resource.data)
          && request.resource.data.id == orderId
          && newBusinessTenancy(request.resource.data)
          && existsAfter(scopedPath('vehicles', request.resource.data.vehicleId))
          && openedOrder(request.resource.data);
        allow update: if isActiveOwner(businessId)
          && validServiceTotals(orderId, request.resource.data.diff(resource.data).affectedKeys(), request.resource.data);
        allow delete: if isActiveOwner(businessId);
      }

      match /repairOrderItems/{itemId} {
        function validServiceItem(itemId, d) {
          let record = getAfter(scopedPath('repairServices', d.repairServiceId)).data;
          return sv_repair_order_items(d)
            && d.id == itemId && d.businessId == businessId && d.ownerUid == request.auth.uid && d.isDeleted == false
            && !exists(scopedPath('repairServices', d.repairServiceId))
            && d.orderId == record.orderId && d.warrantyDays == 0 && d.mechanicId == null
            && d.quantity.scale == 0
            && (d.type == 'part'
              ? record.partItemId == itemId && d.inventoryItemId == record.partId
                && int(d.quantity.unitsText) == record.partQuantity && d.price == record.partPrice && d.cost == record.partCost
              : record.laborItemId == itemId && d.inventoryItemId == null && d.quantity.unitsText == '1' && d.price == record.laborPrice);
        }
        allow get, list: if isActiveOwner(businessId);
        allow create: if isActiveOwner(businessId) && validServiceItem(itemId, request.resource.data);
        allow update: if false;
        // Items go only with their order (ON DELETE CASCADE).
        allow delete: if isActiveOwner(businessId) && !existsAfter(scopedPath('repairOrders', resource.data.orderId));
      }

      // repairServices/{id}: one immutable record per add_repair_service_transaction call.
      match /repairServices/{serviceId} {
        function validServicePart(serviceId, d) {
          let part = d.partId == null ? null : get(scopedPath('parts', d.partId)).data;
          let partAfter = d.partId == null ? null : getAfter(scopedPath('parts', d.partId)).data;
          return d.partId == null
            ? d.partQuantity == 0 && d.partItemId == null && int(d.partPrice.unitsText) == 0 && int(d.partCost.unitsText) == 0
            : d.partQuantity is int && d.partQuantity > 0 && part.quantity >= d.partQuantity
              && partAfter.quantity == part.quantity - d.partQuantity && partAfter.lastRepairServiceId == serviceId
              && isProduct(d.partPrice, decimalOrZero(part.get('sellingPriceUnit', null)), d.partQuantity)
              && isProduct(d.partCost, decimalOrZero(part.get('purchasePriceUnit', null)), d.partQuantity)
              && d.partItemId is string
              && getAfter(scopedPath('repairOrderItems', d.partItemId)).data.repairServiceId == serviceId;
        }
        function validRepairService(serviceId, d) {
          let before = get(scopedPath('repairOrders', d.orderId)).data;
          let after = getAfter(scopedPath('repairOrders', d.orderId)).data;
          return d.keys().hasOnly(['id', 'orderId', 'actorUid', 'businessId', 'ownerUid', 'partId', 'partQuantity', 'partPrice',
              'partCost', 'laborPrice', 'partItemId', 'laborItemId', 'createdAt', 'schemaVersion'])
            && d.id == serviceId && d.businessId == businessId && d.ownerUid == request.auth.uid && d.actorUid == request.auth.uid
            && d.createdAt == request.time && d.schemaVersion == 1
            && sfDecimal(d.partPrice) && sfDecimal(d.partCost) && sfDecimal(d.laborPrice)
            && after.lastRepairServiceId == serviceId
            && isSum2(after.partsTotal, decimalOrZero(before.get('partsTotal', null)), d.partPrice)
            && isSum2(after.laborTotal, decimalOrZero(before.get('laborTotal', null)), d.laborPrice)
            && isSum3(after.totalAmount, decimalOrZero(before.get('totalAmount', null)), d.partPrice, d.laborPrice)
            && validServicePart(serviceId, d)
            && (d.laborItemId == null
              ? int(d.laborPrice.unitsText) == 0
              : d.laborItemId is string
                && getAfter(scopedPath('repairOrderItems', d.laborItemId)).data.repairServiceId == serviceId);
        }
        allow get, list: if isActiveOwner(businessId);
        allow create: if isActiveOwner(businessId) && validRepairService(serviceId, request.resource.data);
        allow update: if false;
        allow delete: if isActiveOwner(businessId) && !existsAfter(scopedPath('repairOrders', resource.data.orderId));
      }

      // car_parts: CarPartsInventory creates, edits and deletes the business's parts; a repair service consumes stock only
      // through its service record. The source grants the owner every operation on these rows, with no CHECK beyond types.
      match /parts/{partId} {
        function consumedByService(partId, changed, d) {
          return changed.hasOnly(['quantity', 'updatedAt', 'updatedAtMicros', 'lastRepairServiceId'])
            && 'lastRepairServiceId' in changed
            && d.quantity is int && d.quantity >= 0
            && d.updatedAt == request.time
            && !exists(scopedPath('repairServices', d.lastRepairServiceId))
            && getAfter(scopedPath('repairServices', d.lastRepairServiceId)).data.partId == partId;
        }
        // PartFormModal saves the columns it shows; the update_car_parts_updated_at trigger stamps updated_at.
        function validPartEdit(changed, d) {
          return changed.hasOnly(['partName', 'description', 'serialNumber', 'compatibleCars', 'quantity', 'purchasePriceUnit',
              'purchasePriceTotal', 'sellingPriceUnit', 'updatedAt', 'updatedAtMicros'])
            && svu_car_parts(changed, d)
            && d.updatedAt == request.time;
        }
        function validPartUpdate(partId, changed, d) {
          return validPartEdit(changed, d) || consumedByService(partId, changed, d);
        }
        allow get, list: if isActiveOwner(businessId);
        allow create: if isActiveOwner(businessId)
          && sv_car_parts(request.resource.data)
          && request.resource.data.id == partId
          && newBusinessTenancy(request.resource.data)
          && request.resource.data.get('lastRepairServiceId', null) == null;
        allow update: if isActiveOwner(businessId)
          && validPartUpdate(partId, request.resource.data.diff(resource.data).affectedKeys(), request.resource.data);
        // No table references car_parts; repair items keep their inventory_item_id, as in the source.
        allow delete: if isActiveOwner(businessId);
      }

      // ---- Restaurant ----------------------------------------------------------------------------------------------
      // The source scopes every restaurant table by business_id = the owner uid, under owner-only RLS. Here the owner
      // and the business's active restaurant members act by role (restaurantMemberships). Money is never trusted from
      // the client: an order keeps itemsTotal, the exact sum of its active lines, and a line changes only in the same
      // write as the order's ledger, whose difference these rules recompute. Manager actions carry an audit record.
      function bizOwnerUid() { return get(businessPath(businessId)).data.ownerUid; }
      function restaurantMember() {
        return hasActiveMembership(businessId) && get(businessPath(businessId)).data.get('isSuspended', false) != true;
      }
      function memberRoleIn(roles) { return restaurantMember() && staffRole(businessId) in roles; }
      function restaurantReader() { return isActiveOwner(businessId) || restaurantMember(); }
      function restaurantManager() { return isActiveOwner(businessId) || memberRoleIn(['super_admin', 'branch_manager']); }
      function orderTaker() { return isActiveOwner(businessId) || memberRoleIn(['super_admin', 'branch_manager', 'waiter']); }
      function kitchenActor() { return isActiveOwner(businessId) || memberRoleIn(['super_admin', 'branch_manager', 'kitchen_staff']); }
      function restaurantTenancy(d) {
        return d.businessId == businessId && d.ownerUid == bizOwnerUid() && d.isDeleted == false && !('createdBy' in d);
      }
      function ownerScoped(d) { return restaurantTenancy(d) && d.legacyBusinessUserId == bizOwnerUid(); }
      function orderPath(id) { return scopedPath('orders', id); }
      function unitsAt(v, scale) { return int(v.unitsText) * pow10(scale - v.scale); }
      function decimalEqual(a, b) {
        let scale = a.scale > b.scale ? a.scale : b.scale;
        return unitsAt(a, scale) == unitsAt(b, scale);
      }
      function activeLine(m) { return m != null && m.get('status', 'pending') != 'cancelled' && m.get('voided', false) != true; }
      function lineUnitsAt(m, scale) {
        return activeLine(m) ? int(m.priceAtTime.unitsText) * m.quantity * pow10(scale - m.priceAtTime.scale) : 0;
      }
      function openStatus(status) { return !(status in ['closed', 'cancelled']); }

      match /tables/{tableId} {
        allow get, list: if restaurantReader();
        allow create: if restaurantManager()
          && sv_restaurant_tables(request.resource.data)
          && request.resource.data.id == tableId
          && ownerScoped(request.resource.data);
        allow update: if (restaurantManager()
            && tenancyKept(request.resource.data.diff(resource.data).affectedKeys())
            && svu_restaurant_tables(request.resource.data.diff(resource.data).affectedKeys(), request.resource.data))
          || (orderTaker()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && svu_restaurant_tables(request.resource.data.diff(resource.data).affectedKeys(), request.resource.data));
        allow delete: if restaurantManager();
      }

      match /restaurantStaff/{staffId} {
        allow get, list: if restaurantReader();
        // sv_restaurant_staff has no PIN, PIN hash or password key: a credential is refused, never stored.
        allow create: if restaurantManager()
          && sv_restaurant_staff(request.resource.data)
          && request.resource.data.id == staffId
          && ownerScoped(request.resource.data);
        allow update: if restaurantManager()
          && tenancyKept(request.resource.data.diff(resource.data).affectedKeys())
          && svu_restaurant_staff(request.resource.data.diff(resource.data).affectedKeys(), request.resource.data);
        allow delete: if restaurantManager();
      }

      // restaurantCounters/orders replaces the global order_number sequence: numbers move only with a new order.
      match /restaurantCounters/{counterId} {
        allow get, list: if restaurantReader();
        allow create, update: if orderTaker()
          && counterId == 'orders'
          && request.resource.data.keys().hasOnly(['next', 'lastOrderId', 'businessId', 'schemaVersion'])
          && request.resource.data.businessId == businessId
          && request.resource.data.schemaVersion == 1
          && request.resource.data.next == (resource == null ? 1 : resource.data.next) + 1
          && request.resource.data.lastOrderId is string
          && !exists(orderPath(request.resource.data.lastOrderId))
          && getAfter(orderPath(request.resource.data.lastOrderId)).data.orderNumber == request.resource.data.next - 1;
        allow delete: if false;
      }

      match /orders/{orderId} {
        function zeroAmount(v) { return v != null && int(v.unitsText) == 0; }
        function openedOrder(d) {
          return d.status == 'draft' && d.paymentStatus == 'pending' && d.closedAt == null && d.paymentMethod == null
            && zeroAmount(d.subtotalAmount) && zeroAmount(d.discountAmount) && zeroAmount(d.discountPercentage)
            && zeroAmount(d.taxAmount) && zeroAmount(d.tipAmount) && zeroAmount(d.totalAmount)
            && zeroAmount(d.itemsTotal) && d.ledgerRevision == 0 && d.ledgerItemId == null && d.get('lastAuditId', null) == null;
        }
        function counterPath() { return scopedPath('restaurantCounters', 'orders'); }
        function numberedOrder(d) {
          return d.orderNumber == (exists(counterPath()) ? get(counterPath()).data.next : 1)
            && getAfter(counterPath()).data.lastOrderId == orderId;
        }
        // One line changed with this write; itemsTotal moves by exactly its active amount after minus before.
        function ledgerMoved(before, d) {
          let itemPath = scopedPath('orderItems', d.ledgerItemId);
          let lineBefore = exists(itemPath) ? get(itemPath).data : null;
          let lineAfter = existsAfter(itemPath) ? getAfter(itemPath).data : null;
          let scale = d.itemsTotal.scale;
          return d.ledgerItemId is string
            && d.ledgerRevision == before.get('ledgerRevision', 0) + 1
            && sfDecimal(d.itemsTotal)
            && (lineBefore != null || lineAfter != null)
            && (lineBefore == null || lineBefore.orderId == orderId)
            && (lineAfter == null || lineAfter.orderId == orderId)
            && int(d.itemsTotal.unitsText) == unitsAt(decimalOrZero(before.get('itemsTotal', null)), scale)
              + lineUnitsAt(lineAfter, scale) - lineUnitsAt(lineBefore, scale);
        }
        // OrderModal save and payment: total = max(0, itemsTotal - discount_amount).
        function netTotal(d) {
          let items = decimalOrZero(d.get('itemsTotal', null));
          let discount = decimalOrZero(d.discountAmount);
          let inner = items.scale > discount.scale ? items.scale : discount.scale;
          let scale = inner > d.totalAmount.scale ? inner : d.totalAmount.scale;
          let net = unitsAt(items, scale) - unitsAt(discount, scale);
          return unitsAt(d.totalAmount, scale) == (net > 0 ? net : 0);
        }
        // tax = total * 0.17 / 1.17 as the screens compute it in floating point.
        function taxMatches(d) {
          return math.abs(sfDecimalValue(d.taxAmount) - sfDecimalValue(d.totalAmount) * 17.0 / 117.0) <= 0.005;
        }
        // EditRestaurantOrderModal: total = the line sum; subtotal and tax split from it.
        function editedTotals(d) {
          return decimalEqual(d.totalAmount, decimalOrZero(d.get('itemsTotal', null)))
            && math.abs(sfDecimalValue(d.subtotalAmount) - sfDecimalValue(d.totalAmount) / 1.17) <= 0.005
            && math.abs(sfDecimalValue(d.taxAmount) - (sfDecimalValue(d.totalAmount) - sfDecimalValue(d.subtotalAmount))) <= 0.005;
        }
        function auditBound(d, action) {
          let path = scopedPath('restaurantAuditLogs', d.lastAuditId);
          return d.lastAuditId is string && !exists(path)
            && getAfter(path).data.actionType == action && getAfter(path).data.entityId == orderId;
        }
        // apply_discount_secure: percentage of subtotal_amount (exact, scale widened by the /100), or a fixed amount, or reset.
        function percentageDiscount(sub, pct, amt, d) {
          let scale = sub.scale + pct.scale + 2;
          let discountUnits = int(sub.unitsText) * int(pct.unitsText);
          let net = int(sub.unitsText) * pow10(pct.scale + 2) - discountUnits;
          return amt.scale <= scale && d.totalAmount.scale <= scale && d.discountReason is string
            && unitsAt(amt, scale) == discountUnits && unitsAt(d.totalAmount, scale) == (net > 0 ? net : 0);
        }
        function amountDiscount(sub, amt, d) {
          let inner = sub.scale > amt.scale ? sub.scale : amt.scale;
          let scale = inner > d.totalAmount.scale ? inner : d.totalAmount.scale;
          let net = unitsAt(sub, scale) - unitsAt(amt, scale);
          return int(d.discountPercentage.unitsText) == 0 && d.discountReason is string
            && unitsAt(d.totalAmount, scale) == (net > 0 ? net : 0);
        }
        function discountApplied(before, d) {
          let sub = decimalOrZero(before.subtotalAmount);
          let pct = decimalOrZero(d.discountPercentage);
          let amt = decimalOrZero(d.discountAmount);
          return int(pct.unitsText) > 0 ? percentageDiscount(sub, pct, amt, d)
            : int(amt.unitsText) > 0 ? amountDiscount(sub, amt, d)
            : int(pct.unitsText) == 0 && int(amt.unitsText) == 0 && d.discountReason == null && decimalEqual(d.totalAmount, sub);
        }
        // The source marks an order refunded when the refund amount is within 0.01 of total_amount.
        function refundCoversTotal(before, d) {
          let audit = getAfter(scopedPath('restaurantAuditLogs', d.lastAuditId)).data;
          return audit.get('detailsEncoding', null) == 'native' && audit.details.get('amount', null) is number
            && math.abs(float(audit.details.amount) - sfDecimalValue(decimalOrZero(before.totalAmount))) < 0.01;
        }
        function orderUpdate(changed, before, d) {
          return (changed.hasOnly(['itemsTotal', 'ledgerRevision', 'ledgerItemId'])
              && (openStatus(before.status) ? orderTaker() : restaurantManager())
              && ledgerMoved(before, d))
            || (changed.hasOnly(['status', 'tableId', 'sessionId', 'notes', 'isRush', 'isVip', 'courseNumber', 'guestId', 'orderType'])
              && orderTaker() && openStatus(before.status) && openStatus(d.status)
              && svu_restaurant_orders(changed, d))
            || (changed.hasOnly(['totalAmount', 'taxAmount'])
              && orderTaker() && openStatus(before.status)
              && svu_restaurant_orders(changed, d) && netTotal(d) && taxMatches(d))
            || (changed.hasOnly(['status', 'closedAt', 'closedAtMicros', 'paymentMethod', 'totalAmount', 'taxAmount'])
              && orderTaker() && openStatus(before.status)
              && d.status == 'closed' && d.closedAt == request.time && d.paymentMethod in ['cash', 'card', 'split']
              && svu_restaurant_orders(changed, d) && netTotal(d) && taxMatches(d))
            || (changed.hasOnly(['totalAmount', 'subtotalAmount', 'taxAmount'])
              && restaurantManager() && svu_restaurant_orders(changed, d) && editedTotals(d))
            || (changed.hasOnly(['discountPercentage', 'discountAmount', 'discountReason', 'totalAmount', 'lastAuditId'])
              && restaurantManager() && openStatus(before.status)
              && svu_restaurant_orders(changed, d) && auditBound(d, 'APPLY_DISCOUNT') && discountApplied(before, d))
            || (changed.hasOnly(['status', 'notes', 'closedAt', 'closedAtMicros', 'lastAuditId'])
              && restaurantManager() && before.status != 'cancelled' && d.status == 'cancelled'
              && (!('closedAt' in changed) || d.closedAt == request.time)
              && svu_restaurant_orders(changed, d) && auditBound(d, 'ORDER_CANCELLED'))
            || (changed.hasOnly(['paymentStatus', 'closedAt', 'closedAtMicros', 'lastAuditId'])
              && restaurantManager() && d.paymentStatus == 'refunded' && d.closedAt == request.time
              && svu_restaurant_orders(changed, d) && auditBound(d, 'REFUND') && refundCoversTotal(before, d))
            || (changed.hasOnly(['serverId']) && restaurantManager() && d.serverId == null);
        }
        allow get, list: if restaurantReader();
        allow create: if orderTaker()
          && sv_restaurant_orders(request.resource.data)
          && request.resource.data.id == orderId
          && ownerScoped(request.resource.data)
          && openedOrder(request.resource.data)
          && numberedOrder(request.resource.data);
        allow update: if orderUpdate(request.resource.data.diff(resource.data).affectedKeys(), resource.data, request.resource.data);
        allow delete: if restaurantManager();
      }

      match /orderItems/{itemId} {
        function lineUnchanged(before, d) {
          return activeLine(before) == activeLine(d)
            && (!activeLine(d) || (before.quantity == d.quantity && before.priceAtTime == d.priceAtTime));
        }
        function ledgerBound(orderId) {
          let before = get(orderPath(orderId)).data;
          let after = getAfter(orderPath(orderId)).data;
          return after.get('ledgerItemId', null) == itemId && after.get('ledgerRevision', 0) == before.get('ledgerRevision', 0) + 1;
        }
        // Lines of an open order belong to the floor; a closed or cancelled order is changed only by a manager.
        function lineWriter(orderId) {
          return openStatus(getAfter(orderPath(orderId)).data.status) ? orderTaker() : restaurantManager();
        }
        // A waiter sells at the menu price; price overrides (analytics edit, business lunch) are the managers'.
        function pricedLine(d) {
          return restaurantManager()
            || (d.itemId != null && decimalEqual(d.priceAtTime, get(scopedPath('menuItems', d.itemId)).data.price));
        }
        function editedLine(changed, before, d) {
          return changed.hasOnly(['itemId', 'quantity', 'priceAtTime', 'notes', 'courseNumber', 'seatNumber', 'isFired', 'status',
              'voided', 'voidReason'])
            && svu_restaurant_order_items(changed, d)
            && lineWriter(d.orderId)
            && (!changed.hasAny(['priceAtTime', 'itemId']) || pricedLine(d))
            && (d.itemId == null || !('itemId' in changed) || exists(scopedPath('menuItems', d.itemId)))
            && ((activeLine(d) || !activeLine(before)) || restaurantManager())
            && (lineUnchanged(before, d) || ledgerBound(d.orderId));
        }
        // sendToKitchen: the line records the ticket line it was sent with, once.
        function sentToKitchen(changed, before, d) {
          return changed.hasOnly(['ticketItemId'])
            && before.get('ticketItemId', null) == null && d.ticketItemId is string
            && orderTaker()
            && !exists(scopedPath('ticketItems', d.ticketItemId))
            && getAfter(scopedPath('ticketItems', d.ticketItemId)).data.orderItemId == itemId;
        }
        // Cancelling an order cancels its lines in the same write; a cancelled order has no ledger to keep.
        function cancelledWithOrder(changed, d) {
          return changed.hasOnly(['status', 'voided', 'voidReason'])
            && restaurantManager()
            && getAfter(orderPath(d.orderId)).data.status == 'cancelled'
            && svu_restaurant_order_items(changed, d);
        }
        allow get, list: if restaurantReader();
        allow create: if sv_restaurant_order_items(request.resource.data)
          && request.resource.data.id == itemId
          && restaurantTenancy(request.resource.data)
          && existsAfter(orderPath(request.resource.data.orderId))
          && lineWriter(request.resource.data.orderId)
          && request.resource.data.status == 'pending' && request.resource.data.voided == false
          && request.resource.data.ticketItemId == null
          && (request.resource.data.itemId == null || exists(scopedPath('menuItems', request.resource.data.itemId)))
          && pricedLine(request.resource.data)
          && ledgerBound(request.resource.data.orderId);
        allow update: if sentToKitchen(request.resource.data.diff(resource.data).affectedKeys(), resource.data, request.resource.data)
          || cancelledWithOrder(request.resource.data.diff(resource.data).affectedKeys(), request.resource.data)
          || editedLine(request.resource.data.diff(resource.data).affectedKeys(), resource.data, request.resource.data);
        // A line goes with its order (ON DELETE CASCADE), or alone with its ledger change.
        allow delete: if restaurantManager()
          && (!existsAfter(orderPath(resource.data.orderId)) || ledgerBound(resource.data.orderId));
      }

      match /orderItemModifiers/{linkId} {
        allow get, list: if restaurantReader();
        allow create, update: if false;
        allow delete: if restaurantManager() && !existsAfter(scopedPath('orderItems', resource.data.orderItemId));
      }

      match /kitchenTickets/{ticketId} {
        function ticketTableName(order) {
          return order.tableId != null && exists(scopedPath('tables', order.tableId))
            ? get(scopedPath('tables', order.tableId)).data.name : 'Counter';
        }
        function openedTicket(d) {
          return sv_restaurant_kitchen_tickets(d)
            && d.id == ticketId
            && ownerScoped(d)
            && d.status == 'new' && d.priority == 0
            && d.startedAt == null && d.completedAt == null && d.servedAt == null
            && d.tableName == ticketTableName(get(orderPath(d.orderId)).data);
        }
        function ticketProgress(changed, d) {
          return changed.hasOnly(['status', 'startedAt', 'startedAtMicros', 'completedAt', 'completedAtMicros', 'servedAt', 'servedAtMicros'])
            && kitchenActor()
            && svu_restaurant_kitchen_tickets(changed, d)
            && (!('startedAt' in changed) || d.startedAt == request.time)
            && (!('completedAt' in changed) || d.completedAt == request.time)
            && (!('servedAt' in changed) || d.servedAt == request.time);
        }
        allow get, list: if restaurantReader();
        allow create: if orderTaker() && openedTicket(request.resource.data);
        allow update: if ticketProgress(request.resource.data.diff(resource.data).affectedKeys(), request.resource.data);
        allow delete: if restaurantManager() && !existsAfter(orderPath(resource.data.orderId));
      }

      match /ticketItems/{ticketItemId} {
        // create_kitchen_ticket: one ticket line per fired, not yet sent order line, copied from that line and its menu item.
        function sentLine(d) {
          let linePath = scopedPath('orderItems', d.orderItemId);
          let line = get(linePath).data;
          let ticketPath = scopedPath('kitchenTickets', d.ticketId);
          return sv_restaurant_ticket_items(d)
            && d.id == ticketItemId
            && restaurantTenancy(d)
            && d.status == 'pending' && d.startedAt == null && d.completedAt == null && d.modifiersText == null
            && line.get('ticketItemId', null) == null && line.isFired == true
            && getAfter(linePath).data.ticketItemId == ticketItemId
            && getAfter(ticketPath).data.orderId == line.orderId
            && d.quantity == line.quantity && d.notes == line.notes
            && d.itemName == get(scopedPath('menuItems', line.itemId)).data.name;
        }
        function lineProgress(changed, d) {
          return changed.hasOnly(['status', 'startedAt', 'startedAtMicros', 'completedAt', 'completedAtMicros'])
            && kitchenActor()
            && svu_restaurant_ticket_items(changed, d)
            && (!('startedAt' in changed) || d.startedAt == request.time)
            && (!('completedAt' in changed) || d.completedAt == request.time);
        }
        allow get, list: if restaurantReader();
        allow create: if orderTaker() && sentLine(request.resource.data);
        allow update: if lineProgress(request.resource.data.diff(resource.data).affectedKeys(), request.resource.data);
        allow delete: if restaurantManager()
          && (!existsAfter(scopedPath('kitchenTickets', resource.data.ticketId))
            || !existsAfter(scopedPath('orderItems', resource.data.orderItemId)));
      }

      match /voidLogs/{logId} {
        function voidedLine(d) {
          let linePath = scopedPath('orderItems', d.orderItemId);
          let before = get(linePath).data;
          let scale = d.originalAmount.scale > before.priceAtTime.scale ? d.originalAmount.scale : before.priceAtTime.scale;
          return sv_restaurant_void_logs(d)
            && d.id == logId
            && ownerScoped(d)
            && d.voidType == 'item' && d.performedBy == null && d.createdAt == request.time
            && d.orderId == before.orderId
            && activeLine(before) && !activeLine(getAfter(linePath).data)
            && unitsAt(d.originalAmount, scale) == lineUnitsAt(before, scale)
            && (d.approvedBy == null || d.approvedBy == membershipOf(businessId).staffId);
        }
        allow get, list: if restaurantManager();
        allow create: if restaurantManager() && voidedLine(request.resource.data);
        // SET NULL when the order, the line or a staff member is deleted; nothing else ever changes.
        allow update: if restaurantManager()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderId', 'orderItemId', 'approvedBy', 'performedBy'])
          && (!('orderId' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.orderId == null)
          && (!('orderItemId' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.orderItemId == null)
          && (!('approvedBy' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.approvedBy == null)
          && (!('performedBy' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.performedBy == null);
        allow delete: if false;
      }

      match /restaurantAuditLogs/{logId} {
        function audited(d) {
          return sv_restaurant_audit_logs(d)
            && d.id == logId
            && ownerScoped(d)
            && d.actorId == request.auth.uid && d.createdAt == request.time
            && (d.staffId == null || d.staffId == membershipOf(businessId).staffId)
            && d.entityId is string
            && (d.actionType == 'VOID_ITEM'
              ? activeLine(get(scopedPath('orderItems', d.entityId)).data)
                && !activeLine(getAfter(scopedPath('orderItems', d.entityId)).data)
              : d.actionType == 'REFUND'
              ? exists(orderPath(d.entityId))
              : d.actionType in ['APPLY_DISCOUNT', 'ORDER_CANCELLED']
                && getAfter(orderPath(d.entityId)).data.get('lastAuditId', null) == logId);
        }
        function allergyOverride(d) {
          return sv_restaurant_audit_logs(d)
            && d.id == logId
            && ownerScoped(d)
            && isActiveOwner(businessId)
            && d.actorId == request.auth.uid && d.createdAt == request.time
            && d.actionType == 'ALLERGY_OVERRIDE'
            && (d.staffId == null || exists(scopedPath('restaurantStaff', d.staffId)));
        }
        allow get, list: if restaurantManager();
        allow create: if (restaurantManager() && audited(request.resource.data)) || allergyOverride(request.resource.data);
        allow update, delete: if false;
      }

      match /tableSessions/{sessionId} {
        allow get, list: if restaurantReader();
        allow update: if (orderTaker()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt', 'endedAtMicros'])
            && request.resource.data.status == 'closed' && request.resource.data.endedAt == request.time
            && svu_restaurant_table_sessions(request.resource.data.diff(resource.data).affectedKeys(), request.resource.data))
          || (restaurantManager()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tableId'])
            && request.resource.data.tableId == null);
        allow create, delete: if false;
      }
      // ReservationsBoard: seat a waiting party at a table of the business, or mark it left or no-show.
      match /waitlist/{entryId} {
        function waitlistUpdate(changed, d) {
          return svu_restaurant_waitlist(changed, d)
            && ((changed.hasOnly(['status', 'seatedAt', 'seatedAtMicros', 'tableId'])
                && d.status == 'seated' && d.seatedAt == request.time
                && d.tableId is string && exists(scopedPath('tables', d.tableId)))
              || (changed.hasOnly(['status']) && d.status in ['left', 'no_show']));
        }
        allow get, list: if restaurantReader();
        allow update: if (restaurantManager()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tableId'])
            && request.resource.data.tableId == null)
          || (orderTaker() && waitlistUpdate(request.resource.data.diff(resource.data).affectedKeys(), request.resource.data));
        allow create, delete: if false;
      }
      match /reservations/{reservationId} {
        // reservation_date + reservation_time as a UTC timestamp, whole seconds.
        function slotOf(d) {
          let day = d.reservationDate.split('-');
          let clock = d.reservationTime.split('[.]')[0].split(':');
          return timestamp.date(int(day[0]), int(day[1]), int(day[2]))
            + duration.time(int(clock[0]), int(clock[1]), int(clock[2]), 0);
        }
        // trg_validate_reservation_datetime and CHECK (reservation_date >= CURRENT_DATE), on INSERT and on UPDATE.
        function bookable(d) {
          return d.reservationTime.matches('[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,6})?')
            && slotOf(d) >= request.time
            && d.partySize >= 1 && d.partySize <= 50
            && (d.durationMinutes == null || (d.durationMinutes >= 15 && d.durationMinutes <= 480));
        }
        function reservationTenancy(d) {
          return d.businessId == businessId && d.ownerUid == bizOwnerUid() && d.isDeleted == false
            && d.legacyBusinessUserId == bizOwnerUid() && d.createdBy == null;
        }
        allow get, list: if restaurantReader();
        allow create: if orderTaker()
          && sv_restaurant_reservations(request.resource.data)
          && request.resource.data.id == reservationId
          && reservationTenancy(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.status == 'pending' && request.resource.data.seatedAt == null
          && (request.resource.data.guestId == null || exists(scopedPath('guestProfiles', request.resource.data.guestId)))
          && bookable(request.resource.data);
        allow update: if orderTaker()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'seatedAt', 'seatedAtMicros'])
          && svu_restaurant_reservations(request.resource.data.diff(resource.data).affectedKeys(), request.resource.data)
          && (!('seatedAt' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.seatedAt == request.time)
          && bookable(request.resource.data);
        allow delete: if false;
      }
      // GuestProfiles: the detail panel edits what a host records about a guest; visits and spend stay out of reach.
      match /guestProfiles/{guestId} {
        allow get, list: if restaurantReader();
        allow update: if restaurantManager()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'fullName', 'phone', 'email',
            'favoriteItems', 'dietaryRestrictions', 'allergies', 'seatingPreference', 'noisePreference', 'preferredServerId', 'notes', 'tags',
            'birthdate', 'anniversary', 'vipLevel', 'marketingOptIn', 'whatsappOptIn', 'updatedAt', 'updatedAtMicros'])
          && request.resource.data.updatedAt == request.time
          && svu_restaurant_guest_profiles(request.resource.data.diff(resource.data).affectedKeys(), request.resource.data)
          && (request.resource.data.preferredServerId == null
            || exists(scopedPath('restaurantStaff', request.resource.data.preferredServerId)));
        allow create, delete: if false;
      }
      // Flows only unmounted screens reach (payments, reports, modifiers, cash): read-only.
      match /modifierGroups/{groupId} { allow get, list: if restaurantReader(); allow write: if false; }
      match /modifiers/{modifierId} { allow get, list: if restaurantReader(); allow write: if false; }
      match /dailyReports/{reportId} { allow get, list: if restaurantManager(); allow write: if false; }
      match /cashDrawers/{drawerId} { allow get, list: if restaurantManager(); allow write: if false; }
      match /cashTransactions/{transactionId} { allow get, list: if restaurantManager(); allow write: if false; }
      match /restaurantPayments/{paymentId} {
        allow get, list: if restaurantManager();
        allow create, update: if false;
        allow delete: if restaurantManager() && !existsAfter(orderPath(resource.data.orderId));
      }
    }

    match /sparkOperations/{operationId} {
      allow get: if signedIn()
        && (!exists(operationPath(operationId)) || resource.data.actorUid == request.auth.uid);
      allow list: if false;
      allow create: if activeTenant(request.resource.data.businessId)
        && request.resource.data.keys().hasAll(['schemaVersion','operationId','type',
          'actorUid','ownerUid','businessId','tripId','beforeRevision',
          'afterRevision','fingerprint','createdAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.operationId == operationId
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.ownerUid == get(businessPath(request.resource.data.businessId)).data.ownerUid
        && request.resource.data.type in ['trip-create','trip-edit','payment',
          'installment-payment','trip-state']
        && request.resource.data.beforeRevision is int
        && request.resource.data.afterRevision == request.resource.data.beforeRevision + 1
        && request.resource.data.fingerprint is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /trips/{tripId} {
      allow get: if adminReadOnly()
        || (signedIn() && (!exists(tripPath(tripId)) || owns(resource.data)));
      allow list: if adminReadOnly() || owns(resource.data);
      allow create: if request.resource.data.ownerUid
          == op(request.resource.data.lastOperationId).ownerUid
        && request.resource.data.id == tripId
        && request.resource.data.userId == request.resource.data.ownerUid
        && request.resource.data.businessId != null
        && request.resource.data.schemaVersion == 1
        && request.resource.data.revision == 1
        && request.resource.data.isDeleted == false
        && validTripMoney(request.resource.data)
        && operationMatches(request.resource.data.lastOperationId, ['trip-create'],
          request.resource.data.businessId, tripId)
        && op(request.resource.data.lastOperationId).beforeRevision == 0
        && op(request.resource.data.lastOperationId).afterRevision == 1;
      allow update: if validTripUpdate(tripId);
      allow delete: if false;
    }

    function scheduleComplete(plan) {
      return (plan.installmentCount < 1 || existsAfter(installmentPath(plan.scheduleIds[0])))
        && (plan.installmentCount < 2 || existsAfter(installmentPath(plan.scheduleIds[1])))
        && (plan.installmentCount < 3 || existsAfter(installmentPath(plan.scheduleIds[2])))
        && (plan.installmentCount < 4 || existsAfter(installmentPath(plan.scheduleIds[3])))
        && (plan.installmentCount < 5 || existsAfter(installmentPath(plan.scheduleIds[4])))
        && (plan.installmentCount < 6 || existsAfter(installmentPath(plan.scheduleIds[5])))
        && (plan.installmentCount < 7 || existsAfter(installmentPath(plan.scheduleIds[6])))
        && (plan.installmentCount < 8 || existsAfter(installmentPath(plan.scheduleIds[7])));
    }
    function validPlan(data) {
      return data.schemaVersion == 1 && data.status == 'active' && data.isDeleted == false
        && data.currency == getAfter(tripPath(data.tripId)).data.currency
        && data.cardTotalMinor is int && data.cashTotalMinor is int
        && data.cardPaidMinor is int && data.cashPaidMinor is int
        && data.cardTotalMinor >= 0 && data.cashTotalMinor >= 0
        && data.cardPaidMinor >= 0 && data.cardPaidMinor <= data.cardTotalMinor
        && data.cashPaidMinor >= 0 && data.cashPaidMinor <= data.cashTotalMinor
        && data.cardTotalMinor + data.cashTotalMinor
          == getAfter(tripPath(data.tripId)).data.salePriceMinor
        && data.installmentCount is int
        && data.installmentCount >= 0 && data.installmentCount <= 8
        && data.scheduleIds is list && data.scheduleIds.size() == data.installmentCount
        && data.scheduleIds.toSet().size() == data.installmentCount
        && data.installmentBaseMinor is int && data.installmentRemainderMinor is int
        && data.installmentBaseMinor >= 0 && data.installmentRemainderMinor >= 0
        && (data.installmentCount == 0
          ? data.cardTotalMinor == 0
            && data.installmentBaseMinor == 0
            && data.installmentRemainderMinor == 0
          : data.installmentBaseMinor * data.installmentCount
              + data.installmentRemainderMinor == data.cardTotalMinor
            && data.installmentRemainderMinor < data.installmentCount);
    }
    function validPlanUpdate() {
      let operation = getAfter(operationPath(request.resource.data.lastOperationId)).data;
      return request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.id == resource.data.id
        && operation.operationId == request.resource.data.lastOperationId
        && operation.actorUid == request.auth.uid
        && operation.businessId == resource.data.businessId
        && operation.tripId == resource.data.tripId
        && operation.type in ['payment','installment-payment']
        && request.resource.data.cardTotalMinor == resource.data.cardTotalMinor
        && request.resource.data.cashTotalMinor == resource.data.cashTotalMinor
        && request.resource.data.currency == resource.data.currency
        && (operation.type == 'payment'
          ? request.resource.data.cashPaidMinor == resource.data.cashPaidMinor + operation.amountMinor
            && request.resource.data.cardPaidMinor == resource.data.cardPaidMinor
          : request.resource.data.cardPaidMinor == resource.data.cardPaidMinor + operation.amountMinor
            && request.resource.data.cashPaidMinor == resource.data.cashPaidMinor)
        && request.resource.data.cardPaidMinor <= resource.data.cardTotalMinor
        && request.resource.data.cashPaidMinor <= resource.data.cashTotalMinor
        && changedOnly(['cardPaidMinor','cashPaidMinor','lastOperationId','updatedAt']);
    }

    match /tripPaymentPlans/{planId} {
      allow get, list: if adminReadOnly() || owns(resource.data);
      allow create: if request.resource.data.ownerUid
          == op(request.resource.data.lastOperationId).ownerUid
        && request.resource.data.id == planId
        && operationMatches(request.resource.data.lastOperationId, ['trip-create'],
          request.resource.data.businessId, request.resource.data.tripId)
        && validPlan(request.resource.data)
        && scheduleComplete(request.resource.data);
      allow update: if validPlanUpdate();
      allow delete: if false;
    }

    match /tripInstallments/{installmentId} {
      allow get, list: if adminReadOnly() || owns(resource.data);
      allow create: if request.resource.data.ownerUid
          == op(request.resource.data.lastOperationId).ownerUid
        && request.resource.data.id == installmentId
        && operationMatches(request.resource.data.lastOperationId, ['trip-create'],
          request.resource.data.businessId, request.resource.data.tripId)
        && existsAfter(planPath(request.resource.data.paymentPlanId))
        && request.resource.data.paymentPlanId
          == getAfter(planPath(request.resource.data.paymentPlanId)).data.id
        && request.resource.data.installmentNumber is int
        && request.resource.data.installmentNumber >= 1
        && request.resource.data.installmentNumber
          <= getAfter(planPath(request.resource.data.paymentPlanId)).data.installmentCount
        && getAfter(planPath(request.resource.data.paymentPlanId))
          .data.scheduleIds[request.resource.data.installmentNumber - 1] == installmentId
        && request.resource.data.expectedAmountMinor
          == getAfter(planPath(request.resource.data.paymentPlanId)).data.installmentBaseMinor
            + (request.resource.data.installmentNumber
                == getAfter(planPath(request.resource.data.paymentPlanId)).data.installmentCount
              ? getAfter(planPath(request.resource.data.paymentPlanId)).data.installmentRemainderMinor
              : 0)
        && request.resource.data.paidAmountMinor == 0
        && request.resource.data.status == 'scheduled';
      allow update: if request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.paymentPlanId == resource.data.paymentPlanId
        && request.resource.data.id == resource.data.id
        && request.resource.data.expectedAmountMinor == resource.data.expectedAmountMinor
        && operationMatches(request.resource.data.lastOperationId,
          ['installment-payment'], resource.data.businessId, resource.data.tripId)
        && op(request.resource.data.lastOperationId).installmentId == installmentId
        && request.resource.data.paidAmountMinor
          == resource.data.paidAmountMinor + op(request.resource.data.lastOperationId).amountMinor
        && request.resource.data.paidAmountMinor <= resource.data.expectedAmountMinor
        && request.resource.data.status
          == (request.resource.data.paidAmountMinor == resource.data.expectedAmountMinor
            ? 'paid' : 'partial')
        && changedOnly(['paidAmountMinor','status','paidAt','lastOperationId','updatedAt']);
      allow delete: if false;
    }

    function validImmutableEvent(data, eventId) {
      let operation = getAfter(operationPath(eventId)).data;
      return operation.operationId == eventId
        && operation.actorUid == request.auth.uid
        && operation.type in ['payment','installment-payment']
        && data.ownerUid == operation.ownerUid
        && data.businessId == operation.businessId
        && data.operationId == eventId && data.lastOperationId == eventId
        && data.actorUserId == request.auth.uid
        && data.tripId == operation.tripId
        && data.amountMinor == operation.amountMinor
        && data.currency == operation.currency
        && (operation.type != 'installment-payment'
          || data.installmentId == operation.installmentId);
    }
    function validActivity(data) {
      let operation = getAfter(operationPath(data.lastOperationId)).data;
      return operation.operationId == data.lastOperationId
        && operation.actorUid == request.auth.uid
        && operation.type in ['trip-create','trip-edit','payment','installment-payment','trip-state']
        && data.ownerUid == operation.ownerUid
        && data.businessId == operation.businessId
        && data.tripId == operation.tripId
        && data.actorUserId == request.auth.uid;
    }
    match /tripPaymentEvents/{eventId} {
      allow get, list: if adminReadOnly() || owns(resource.data);
      allow create: if validImmutableEvent(request.resource.data, eventId);
      allow update, delete: if false;
    }
    match /tripInstallmentEvents/{eventId} {
      allow get, list: if adminReadOnly() || owns(resource.data);
      allow create: if validImmutableEvent(request.resource.data, eventId)
        && request.resource.data.eventType == 'installment';
      allow update, delete: if false;
    }
    match /tripFinancialAudit/{eventId} {
      allow get, list: if adminReadOnly() || owns(resource.data);
      allow create: if validImmutableEvent(request.resource.data, eventId)
        && request.resource.data.afterMinor
          == request.resource.data.beforeMinor + request.resource.data.amountMinor;
      allow update, delete: if false;
    }
    match /tripActivityLog/{eventId} {
      allow get, list: if adminReadOnly() || owns(resource.data);
      allow create: if validActivity(request.resource.data);
      allow update, delete: if false;
    }
    match /auditEvents/{eventId} {
      allow get, list: if adminReadOnly() || owns(resource.data);
      allow write: if false;
    }

    // Restaurant staff identity.
    //
    // Staff authenticate with Firebase Auth; authorisation lives here. No password, hash or PIN
    // is ever stored in Firestore, which is what retires the SECURITY DEFINER authenticate_staff
    // RPC. A self-registrant may create only a pending, role-less membership for their own uid;
    // everything that grants power requires an approver who already holds one.
    function membershipPath(id) { return /databases/$(database)/documents/restaurantMemberships/$(id); }
    function membershipOf(businessId) {
      return get(membershipPath(businessId + '__' + request.auth.uid)).data;
    }
    function hasActiveMembership(businessId) {
      return signedIn()
        && exists(membershipPath(businessId + '__' + request.auth.uid))
        && membershipOf(businessId).enabled == true
        && membershipOf(businessId).status == 'active';
    }
    function staffRole(businessId) { return membershipOf(businessId).role; }
    function isRestaurantAdmin(businessId) {
      return hasActiveMembership(businessId)
        && staffRole(businessId) in ['super_admin', 'branch_manager'];
    }
    // The business owner administers staff without needing a membership of their own.
    function ownsBusiness(businessId) {
      return signedIn() && exists(businessPath(businessId))
        && get(businessPath(businessId)).data.ownerUid == request.auth.uid;
    }
    function canAdministerStaff(businessId) {
      return ownsBusiness(businessId) || isRestaurantAdmin(businessId);
    }
    function validStaffRole(role) {
      return role in ['super_admin', 'branch_manager', 'kitchen_staff', 'waiter'];
    }
    // An exhaustive key list is what keeps a password, hash or PIN from ever being smuggled
    // onto a membership document. Anything outside this set is refused.
    function membershipKeysOnly(data) {
      return data.keys().hasOnly(['uid', 'businessId', 'staffId', 'role', 'status', 'enabled',
        'approvedBy', 'createdAt', 'updatedAt', 'schemaVersion']);
    }

    match /restaurantMemberships/{membershipId} {
      // A member reads their own membership; an administrator reads the whole roster.
      allow get, list: if signedIn() && (
        resource.data.uid == request.auth.uid || canAdministerStaff(resource.data.businessId));

      // Self-registration: own uid, pending, disabled, no role. The id is bound to the pair so
      // a second membership for the same business cannot be forged under another key.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && membershipId == request.resource.data.businessId + '__' + request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.enabled == false
        && !('role' in request.resource.data)
        && !('approvedBy' in request.resource.data)
        && membershipKeysOnly(request.resource.data)
        && request.resource.data.schemaVersion == 1;

      // Administration. businessId and uid are immutable, the approver is never the subject,
      // and the role must be one the product defines.
      allow update: if canAdministerStaff(resource.data.businessId)
        && membershipKeysOnly(request.resource.data)
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && resource.data.uid != request.auth.uid
        && validStaffRole(request.resource.data.role)
        && request.resource.data.status in ['pending', 'active', 'suspended']
        && (request.resource.data.status == 'active') == (request.resource.data.enabled == true)
        && request.resource.data.approvedBy == request.auth.uid;

      // Memberships are disabled, never deleted, so the audit trail survives.
      allow delete: if false;
    }

    match /idempotency/{id} { allow read, write: if false; }
    match /storageCleanupQueue/{id} { allow read, write: if false; }
    match /rateLimits/{id} { allow read, write: if false; }
    match /featureRollouts/{id} {
      allow get, list: if signedIn();
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}

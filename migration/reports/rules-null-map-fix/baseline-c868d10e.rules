    }
    function sv_restaurant_menu_items(d) {
      return d.keys().hasOnly(['allergens', 'availableDays', 'availableFrom', 'availableUntil', 'barcode', 'businessId', 'calories', 'categoryId', 'costPrice', 'countryOfOrigin', 'createdAt', 'createdAtMicros', 'createdBy', 'defaultShelfLifeDays', 'description', 'dietaryTags', 'id', 'imageUrl', 'isAvailable', 'isDeleted', 'isNew', 'isPerishable', 'isPopular', 'legacyBusinessUserId', 'migrationExcludedFields', 'migrationTransformVersion', 'minStockAlert', 'name', 'nameAr', 'nameHe', 'ownerUid', 'partNumber', 'prepTimeMinutes', 'price', 'requiresWeighing', 'schemaVersion', 'soldByWeight', 'sortOrder', 'spicyLevel', 'station', 'stockQuantity', 'supplierSku', 'taxRate', 'trackExpiry', 'transformVersion', 'type', 'weightUnit']) && [
        d.id is string,
        d.name is string,
        sfDecimal(d.price),
        d.taxRate == null || sfDecimal(d.taxRate),
        d.createdAt is timestamp,
        d.get('createdAtMicros', '0').matches('-?[0-9]+'),
        d.costPrice == null || sfDecimal(d.costPrice),
        d.station in [null, 'grill', 'fry', 'salad', 'bar', 'expo', 'dessert', 'general'],
        d.allergens == null || d.allergens is list,
        d.availableDays == null || d.availableDays is list,
        d.spicyLevel in [null, 0, 1, 2, 3],
        d.dietaryTags == null || d.dietaryTags is list,
        d.weightUnit in [null, 'kg', 'g', 'lb', 'oz'],
        d.type in [null, 'unit', 'weight'],
        d.stockQuantity == null || sfDecimal(d.stockQuantity),
        sfStrings([d.categoryId, d.description, d.nameHe, d.nameAr, d.imageUrl, d.availableFrom, d.availableUntil, d.supplierSku, d.countryOfOrigin, d.legacyBusinessUserId, d.barcode, d.partNumber]),

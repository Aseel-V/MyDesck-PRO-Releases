rules_version = '2';

// MyDesck PRO Spark-only rules. Firebase Auth identity plus these rules are the
// production authority. No client, Electron process, Function, or Admin SDK is
// trusted by the normal runtime.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.uid != null; }
    function adminReadOnly() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function businessPath(id) { return /databases/$(database)/documents/businesses/$(id); }
    function operationPath(id) { return /databases/$(database)/documents/sparkOperations/$(id); }
    function tripPath(id) { return /databases/$(database)/documents/trips/$(id); }
    function planPath(id) { return /databases/$(database)/documents/tripPaymentPlans/$(id); }
    function installmentPath(id) { return /databases/$(database)/documents/tripInstallments/$(id); }

    function profile() { return get(userPath(request.auth.uid)).data; }
    function businessOwnerPath(uid) { return /databases/$(database)/documents/businessOwners/$(uid); }
    // The source is_admin(): user_profiles.role = 'admin'. Role is a protected field no client can set.
    function isPlatformAdmin() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && profile().get('role', 'user') == 'admin'
        && profile().get('isSuspended', false) == false
        && profile().get('migrationAuthOnly', false) == false;
    }
    // Owner-only access. The source RLS for owner-scoped tables is auth.uid() = owner; a user merely
    // linked to the business (user_profiles.business_id) is not an owner.
    // A missing business or profile makes get() fail, which refuses the request like `false` does.
    function isActiveOwner(businessId) {
      let business = get(businessPath(businessId)).data;
      return request.auth != null
        && business.ownerUid == request.auth.uid
        && business.get('isSuspended', false) != true
        && get(userPath(request.auth.uid)).data.get('isSuspended', false) == false;
    }
    // A resolved display value (data: or blob:) must never replace a Storage reference.
    function notInlineImage(v) {
      return v == null || (v is string && !v.lower().matches('\\s*(data|blob):[\\s\\S]*'));
    }
    function activeTenant(businessId) {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && profile().isSuspended == false
        && exists(businessPath(businessId))
        && get(businessPath(businessId)).data.get('isSuspended', false) != true
        && (get(businessPath(businessId)).data.ownerUid == request.auth.uid
          || profile().businessId == businessId);
    }
    function owns(data) {
      return activeTenant(data.businessId)
        && data.ownerUid == get(businessPath(data.businessId)).data.ownerUid;
    }
    function exactMoney(value, units, currency) {
      return value is map && value.units is int && value.units == units
        && value.unitsText is string && value.unitsText == string(units)
        && value.scale == 2
        && (!('currency' in value) || value.currency == currency);
    }
    // ---- Tourism: the operation envelope and the trip ledger ------------------------------------
    //
    // Every trip write belongs to one immutable sparkOperations document written in the same commit.
    // `createdAt == request.time` is what proves the operation belongs to THIS request: an operation
    // that already exists cannot be pointed at again to authorise a later write.
    function planIndexPath(id) { return /databases/$(database)/documents/tripPlans/$(id); }
    function freshOperation(id) {
      return existsAfter(operationPath(id))
        && getAfter(operationPath(id)).data.operationId == id
        && getAfter(operationPath(id)).data.actorUid == request.auth.uid
        && getAfter(operationPath(id)).data.createdAt == request.time;
    }
    function tripOperation(data, tripId, types) {
      let operation = getAfter(operationPath(data.lastOperationId)).data;
      return freshOperation(data.lastOperationId)
        && operation.ownerUid == data.ownerUid
        && operation.businessId == data.businessId
        && operation.tripId == tripId
        && operation.type in types;
    }
    // A delete carries no document to read a request id from, so the purge operation's id is derived
    // from the trip. permanently_delete_trips is the only statement that removes a trip or its rows.
    function purgeOperation(tripId) {
      let id = request.auth.uid + '__purge__' + tripId;
      return freshOperation(id)
        && getAfter(operationPath(id)).data.type == 'trip-purge'
        && getAfter(operationPath(id)).data.tripId == tripId;
    }
    // For the rows a statement deletes while the trip itself survives (the unpaid schedule a new plan
    // replaces): the operation the trip document ends this commit pointing at.
    function commitOperation(tripId, types) {
      return existsAfter(tripPath(tripId))
        && tripOperation(getAfter(tripPath(tripId)).data, tripId, types);
    }

    // A trip carries its money twice: the source's exact NUMERIC columns and the minor units the Rules
    // do arithmetic in. exactMoney binds the two, the GENERATED ALWAYS columns are recomputed here, and
    // the collected total is checked against the payment ledger instead of being believed.
    function validTripMoney(data) {
      return data.moneyScale == 2
        && data.salePriceMinor is int
        && data.wholesaleCostMinor is int
        && data.amountPaidMinor is int
        && data.amountDueMinor == data.salePriceMinor - data.amountPaidMinor
        && data.profitMinor == data.salePriceMinor - data.wholesaleCostMinor
        && exactMoney(data.salePrice, data.salePriceMinor, data.currency)
        && exactMoney(data.wholesaleCost, data.wholesaleCostMinor, data.currency)
        && exactMoney(data.amountPaid, data.amountPaidMinor, data.currency)
        && exactMoney(data.amountDue, data.amountDueMinor, data.currency)
        && exactMoney(data.profit, data.profitMinor, data.currency)
        && validSearchDocument(data)
        && tripLedgerBound(data);
    }
    // search_document GENERATED ALWAYS: destination, client, hotel, status and payment status, lowered.
    function validSearchDocument(data) {
      let hotel = data.get('hotelName', null) == null ? '' : data.hotelName;
      return data.searchDocument
        == (data.destination + ' ' + data.clientName + ' ' + hotel + ' ' + data.status + ' ' + data.paymentStatus).lower();
    }
    // tripPlans/{tripId} exists exactly when the trip has a live native plan. With one, the collected
    // total is least(sale, cashConfirmed + visaConfirmed), the canonical summary's figure. Visa
    // collection is date-driven in that contract - an instalment whose due date has passed counts,
    // and the receipt columns are audit-only - so the two figures are carried on the plan and bounded
    // there: a rule cannot recompute them without reading the whole schedule. Without a plan the
    // payload's own amount stands, which is what the source stores for a legacy trip.
    function tripLedgerBound(data) {
      return !existsAfter(planIndexPath(data.id)) || tripLedgerDerived(data);
    }
    // The source writes the collected total by two paths: the payment sync uses the plan's receipts, and
    // save_trip_transaction's last step uses the date-derived summary. Both are bounded by the plan's card total, and a
    // write must equal one of them exactly.
    function tripLedgerDerived(data) {
      let plan = getAfter(planPath(getAfter(planIndexPath(data.id)).data.planId)).data;
      let scheduled = plan.cashConfirmedMinor + plan.visaConfirmedMinor;
      let receipted = plan.cashConfirmedMinor + plan.visaReceiptedMinor;
      let confirmed = data.amountPaidMinor;
      return plan.tripId == data.id
        && plan.ownerUid == data.ownerUid
        && confirmed <= data.salePriceMinor
        && (confirmed == (data.salePriceMinor < scheduled ? data.salePriceMinor : scheduled)
          || confirmed == (data.salePriceMinor < receipted ? data.salePriceMinor : receipted))
        && data.paymentStatus == (confirmed <= 0 ? 'unpaid' : (confirmed >= data.salePriceMinor ? 'paid' : 'partial'));
    }

    // The plan's own CHECK constraints, and the cash rule enforce_cash_payment_plan_row applies.
    function validPlanShape(d) {
      return d.cardPaidMinor <= d.cardTotalMinor
        && d.cashPaidMinor <= d.cashTotalMinor
        && d.visaConfirmedMinor is int
        && d.visaConfirmedMinor >= 0
        && d.visaConfirmedMinor <= d.cardTotalMinor
        && d.visaReceiptedMinor is int
        && d.visaReceiptedMinor >= 0
        && d.visaReceiptedMinor <= d.cardTotalMinor
        && d.cashConfirmedMinor == (d.cashTotalMinor < d.cashPaidMinor ? d.cashTotalMinor : d.cashPaidMinor)
        && (d.source == 'legacy' || d.cardTotalMinor + d.cashTotalMinor > 0)
        && (d.source == 'legacy'
          || (d.cardTotalMinor == 0 && d.installmentCount == 0)
          || (d.cardTotalMinor > 0 && d.installmentCount >= 1))
        && (d.paymentMethod != 'cash'
          || (d.cardTotalMinor == 0 && d.installmentCount == 0 && d.cardPaidMinor == 0));
    }
    // The index is the source's UNIQUE (trip_id) WHERE deleted_at IS NULL AND status <> 'cancelled':
    // a live plan must be the one the index names, so a second live plan cannot exist for a trip.
    function planIndexNames(tripId, planId) {
      return existsAfter(planIndexPath(tripId))
        && getAfter(planIndexPath(tripId)).data.planId == planId
        && getAfter(planIndexPath(tripId)).data.tripId == tripId
        && getAfter(planIndexPath(tripId)).data.ownerUid == request.auth.uid;
    }
    function planIsLive(d) { return d.status != 'cancelled' && d.isDeleted == false && d.source == 'native'; }
    // One installment changes per write, so the plan's receipt total moves by exactly its delta.
    function receiptMoved(planId, before, after) {
      return getAfter(planPath(planId)).data.cardPaidMinor
        == get(planPath(planId)).data.cardPaidMinor
          - (before.paidAt == null ? 0 : before.paidAmountMinor)
          + (after.paidAt == null ? 0 : after.paidAmountMinor);
    }

    // SCHEMA-VALIDATORS:BEGIN (generated by migration/firestore/tools/generate-rules-schema.mjs; do not edit)
    // Every non-null value is a string: joining on U+FFFF (a Unicode noncharacter, reserved for
    // internal use) and splitting again returns the same list only when every element is a string
    // that does not contain it. join() alone would accept numbers, booleans and null.
    function sfStrings(values) {
      let l = values.removeAll([null]).concat(['end']);
      return l.join('\uffff').split('\uffff') == l;
    }
    function sfBools(values) { return values.removeAll([true, false, null]).size() == 0; }
    function sfBoolsRequired(values) { return values.removeAll([true, false]).size() == 0; }
    // Every non-null value is an integer: the joined text holds only integers, it splits into one
    // piece per value (no value contains the separator), and no value is itself a digit string.
    function sfInts(values) {
      let l = values.removeAll([null]).concat([0]);
      let pieces = l.join('\uffff').split('\uffff');
      return l.join('\uffff').matches('-?[0-9]+(\uffff-?[0-9]+)*') && pieces.size() == l.size() && !l.hasAny(pieces);
    }
    // Exact decimal as the migration and the codec write it: unitsText is authoritative, scale is an
    // integer, units is null or the same integer, and there are no other keys. A value whose units do
    // not fit int64 is refused here (the codec marks it exceedsInt64; no product column holds one).
    function sfDecimal(v) {
      return [v.size() == 4, v.scale is int, v.scale >= 0, v.scale <= 32, v.unitsText.matches('-?[0-9]{1,40}'),
        v.decimal is string, v.units in [null, int(v.unitsText)]].hasOnly([true]);
    }
    // NUMERIC(p,s): the codec rounds to scale s and refuses more than p digits.
    function sfDecimalScaled(v, scale, digits) {
      return [v.size() == 4, v.scale == scale, v.unitsText.matches(digits), v.decimal is string,
        v.units in [null, int(v.unitsText)]].hasOnly([true]);
    }
    function sfDecimalValue(v) { return float(v.unitsText) / math.pow(10, v.scale); }
    // JSON is native, or text when Firestore cannot hold the shape; a SQL NULL has no encoding marker.
    function sfJsonRequired(encoding, value, text) {
      return encoding == 'native' || (encoding == 'text' && value == null && text is string);
    }
    function sfJson(encoding, value, text) {
      return sfJsonRequired(encoding, value, text) || (encoding == null && value == null);
    }
    function sv_user_profiles(d) {
      return d.keys().hasOnly(['businessId', 'canViewFinancials', 'createdAt', 'createdAtMicros', 'createdBy', 'fullName', 'id', 'isDeleted', 'isSuspended', 'legacyProfileId', 'migrationAuthOnly', 'migrationExcludedFields', 'migrationTransformVersion', 'ownerUid', 'phoneNumber', 'role', 'schemaVersion', 'sourceBusinessId', 'transformVersion', 'uid', 'updatedAt', 'updatedAtMicros', 'userId']) && [
        d.id is string,
        d.userId is string,
        d.fullName is string,
        d.phoneNumber is string,
        d.role in ['user', 'admin'],
        d.createdAt == null || d.createdAt is timestamp,
        d.get('createdAtMicros', '0').matches('-?[0-9]+'),
        d.updatedAt == null || d.updatedAt is timestamp,
        d.get('updatedAtMicros', '0').matches('-?[0-9]+'),
        d.sourceBusinessId == null || d.sourceBusinessId is string,
        sfBoolsRequired([d.isSuspended, d.canViewFinancials]),
        d.get('schemaVersion', 1) == 1
      ].hasOnly([true]);
    }
    function svu_user_profiles(changed, d) {
      return changed.hasOnly(['businessId', 'canViewFinancials', 'createdAt', 'createdAtMicros', 'createdBy', 'fullName', 'id', 'isDeleted', 'isSuspended', 'legacyProfileId', 'migrationAuthOnly', 'migrationExcludedFields', 'migrationTransformVersion', 'ownerUid', 'phoneNumber', 'role', 'schemaVersion', 'sourceBusinessId', 'transformVersion', 'uid', 'updatedAt', 'updatedAtMicros', 'userId']) && (changed.size() > 8 ? sv_user_profiles(d) : [
        !('id' in changed) || (d.id is string),
        !('userId' in changed) || (d.userId is string),
        !('fullName' in changed) || (d.fullName is string),
        !('phoneNumber' in changed) || (d.phoneNumber is string),
        !('role' in changed) || (d.role in ['user', 'admin']),
        !changed.hasAny(['createdAt', 'createdAtMicros']) || ((d.createdAt == null || d.createdAt is timestamp) && (d.get('createdAtMicros', '0').matches('-?[0-9]+'))),
        !changed.hasAny(['updatedAt', 'updatedAtMicros']) || ((d.updatedAt == null || d.updatedAt is timestamp) && (d.get('updatedAtMicros', '0').matches('-?[0-9]+'))),
        !('sourceBusinessId' in changed) || (d.sourceBusinessId == null || d.sourceBusinessId is string),
        !changed.hasAny(['isSuspended', 'canViewFinancials']) || (sfBoolsRequired([d.isSuspended, d.canViewFinancials])),
        !('schemaVersion' in changed) || (d.get('schemaVersion', 1) == 1)
      ].hasOnly([true]));
    }
    function sv_business_profiles(d) {
      return d.keys().hasOnly(['businessId', 'businessName', 'businessRegistrationNumber', 'businessType', 'createdAt', 'createdAtMicros', 'createdBy', 'id', 'isDeleted', 'isSuspended', 'logoUrl', 'migrationExcludedFields', 'migrationTransformVersion', 'ownerUid', 'preferredCurrency', 'preferredLanguage', 'schemaVersion', 'signatureUrl', 'subscriptionStatus', 'transformVersion', 'trialStartDate', 'trialStartDateMicros', 'updatedAt', 'updatedAtMicros', 'userId']) && [
        d.id is string,
        d.userId is string,
        d.businessName is string,
        d.preferredCurrency is string,
        d.preferredLanguage is string,
        d.createdAt == null || d.createdAt is timestamp,
        d.get('createdAtMicros', '0').matches('-?[0-9]+'),
        d.updatedAt == null || d.updatedAt is timestamp,
        d.get('updatedAtMicros', '0').matches('-?[0-9]+'),
        d.businessType in [null, 'tourism', 'restaurant', 'supermarket', 'phone_shop', 'car_parts', 'clothes_shop', 'furniture_store', 'auto_repair'],
        d.subscriptionStatus in [null, 'active', 'past_due', 'trial'],
        d.trialStartDate == null || d.trialStartDate is timestamp,
        d.get('trialStartDateMicros', '0').matches('-?[0-9]+'),
        sfStrings([d.logoUrl, d.businessRegistrationNumber, d.signatureUrl]),
        d.isSuspended == null || d.isSuspended is bool,
        d.get('schemaVersion', 1) == 1
      ].hasOnly([true]);
    }
    function svu_business_profiles(changed, d) {
      return changed.hasOnly(['businessId', 'businessName', 'businessRegistrationNumber', 'businessType', 'createdAt', 'createdAtMicros', 'createdBy', 'id', 'isDeleted', 'isSuspended', 'logoUrl', 'migrationExcludedFields', 'migrationTransformVersion', 'ownerUid', 'preferredCurrency', 'preferredLanguage', 'schemaVersion', 'signatureUrl', 'subscriptionStatus', 'transformVersion', 'trialStartDate', 'trialStartDateMicros', 'updatedAt', 'updatedAtMicros', 'userId']) && (changed.size() > 8 ? sv_business_profiles(d) : [
        !('id' in changed) || (d.id is string),
        !('userId' in changed) || (d.userId is string),
        !('businessName' in changed) || (d.businessName is string),
        !('preferredCurrency' in changed) || (d.preferredCurrency is string),
        !('preferredLanguage' in changed) || (d.preferredLanguage is string),
        !changed.hasAny(['createdAt', 'createdAtMicros']) || ((d.createdAt == null || d.createdAt is timestamp) && (d.get('createdAtMicros', '0').matches('-?[0-9]+'))),
        !changed.hasAny(['updatedAt', 'updatedAtMicros']) || ((d.updatedAt == null || d.updatedAt is timestamp) && (d.get('updatedAtMicros', '0').matches('-?[0-9]+'))),
        !('businessType' in changed) || (d.businessType in [null, 'tourism', 'restaurant', 'supermarket', 'phone_shop', 'car_parts', 'clothes_shop', 'furniture_store', 'auto_repair']),
        !('subscriptionStatus' in changed) || (d.subscriptionStatus in [null, 'active', 'past_due', 'trial']),
        !changed.hasAny(['trialStartDate', 'trialStartDateMicros']) || ((d.trialStartDate == null || d.trialStartDate is timestamp) && (d.get('trialStartDateMicros', '0').matches('-?[0-9]+'))),
        !changed.hasAny(['logoUrl', 'businessRegistrationNumber', 'signatureUrl']) || (sfStrings([d.logoUrl, d.businessRegistrationNumber, d.signatureUrl])),
        !('isSuspended' in changed) || (d.isSuspended == null || d.isSuspended is bool),

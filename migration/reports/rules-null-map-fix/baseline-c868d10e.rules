        d.prepTimeMinutes == null || d.prepTimeMinutes is int,
        d.calories == null || d.calories is int,
        d.sortOrder == null || d.sortOrder is int,
        d.defaultShelfLifeDays == null || d.defaultShelfLifeDays is int,

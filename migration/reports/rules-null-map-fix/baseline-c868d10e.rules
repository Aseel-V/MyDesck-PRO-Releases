    function svu_restaurant_menu_items(changed, d) {
      return changed.hasOnly(['allergens', 'availableDays', 'availableFrom', 'availableUntil', 'barcode', 'businessId', 'calories', 'categoryId', 'costPrice', 'countryOfOrigin', 'createdAt', 'createdAtMicros', 'createdBy', 'defaultShelfLifeDays', 'description', 'dietaryTags', 'id', 'imageUrl', 'isAvailable', 'isDeleted', 'isNew', 'isPerishable', 'isPopular', 'legacyBusinessUserId', 'migrationExcludedFields', 'migrationTransformVersion', 'minStockAlert', 'name', 'nameAr', 'nameHe', 'ownerUid', 'partNumber', 'prepTimeMinutes', 'price', 'requiresWeighing', 'schemaVersion', 'soldByWeight', 'sortOrder', 'spicyLevel', 'station', 'stockQuantity', 'supplierSku', 'taxRate', 'trackExpiry', 'transformVersion', 'type', 'weightUnit']) && (changed.size() > 11 ? sv_restaurant_menu_items(d) : [
        !('id' in changed) || (d.id is string),
        !('name' in changed) || (d.name is string),
        !('price' in changed) || (sfDecimal(d.price)),
        !('taxRate' in changed) || (d.taxRate == null || sfDecimal(d.taxRate)),
        !changed.hasAny(['createdAt', 'createdAtMicros']) || ((d.createdAt is timestamp) && (d.get('createdAtMicros', '0').matches('-?[0-9]+'))),
        !('costPrice' in changed) || (d.costPrice == null || sfDecimal(d.costPrice)),
        !('station' in changed) || (d.station in [null, 'grill', 'fry', 'salad', 'bar', 'expo', 'dessert', 'general']),
        !('allergens' in changed) || (d.allergens == null || d.allergens is list),
        !('availableDays' in changed) || (d.availableDays == null || d.availableDays is list),
        !('spicyLevel' in changed) || (d.spicyLevel in [null, 0, 1, 2, 3]),
        !('dietaryTags' in changed) || (d.dietaryTags == null || d.dietaryTags is list),
        !('weightUnit' in changed) || (d.weightUnit in [null, 'kg', 'g', 'lb', 'oz']),
        !('type' in changed) || (d.type in [null, 'unit', 'weight']),
        !('stockQuantity' in changed) || (d.stockQuantity == null || sfDecimal(d.stockQuantity)),
